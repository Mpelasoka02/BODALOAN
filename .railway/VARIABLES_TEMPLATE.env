# Complete Railway Setup Template
# Copy these values to your Railway project Variables

# === CRITICAL VARIABLES (Must be set before deployment) ===

# Application Core
APP_NAME=BodaLoan
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:nUCKVU3DrmN1AYOgojq10UV6ojSFti6g5X648d7Qp/k=
APP_TIMEZONE=Africa/Dar_es_Salaam
APP_URL=https://bodaloan-production.up.railway.app
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# === DATABASE (PostgreSQL - MUST be connected in Railway) ===
DB_CONNECTION=pgsql
DB_HOST=${{PGHOST}}
DB_PORT=${{PGPORT}}
DB_DATABASE=${{PGDATABASE}}
DB_USERNAME=${{PGUSER}}
DB_PASSWORD=${{PGPASSWORD}}

# === LOGGING ===
LOG_CHANNEL=stack
LOG_LEVEL=notice
LOG_DEPRECATIONS_CHANNEL=null

# === SESSION & CACHE ===
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=file
CACHE_PREFIX=
BROADCAST_CONNECTION=log

# === QUEUE & FILESYSTEM ===
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# === BCRYPT ===
BCRYPT_ROUNDS=12

# === MAIL (Use 'log' for testing) ===
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@bodaloan.co.tz"
MAIL_FROM_NAME="BodaLoan"

# === FIREBASE (Configure with your Firebase project) ===
FIREBASE_PROJECT_ID=bodaloan
FIREBASE_DATABASE_URL=https://bodaloan-default-rtdb.firebaseio.com
FIREBASE_API_KEY=AIzaSyDJnj6RKqEIq7eEIXl2rMzMOQjCIQm5S0A
FIREBASE_APP_ID=1:1928053682:web:d7a79dc0d5c8ba9ca21aab
FIREBASE_FCM_ENABLED=true
FIREBASE_REALTIME_DB_ENABLED=true
FIREBASE_FCM_SENDER_ID=1928053682
FIREBASE_VAPID_KEY=BJLhA6T944pRxUqYj6Tlui8s42l4aFrVRvmOR_6KXtJp4o7OKEmWcsqg05vEBibDZ41vjWIWF_RBBu8P5rd4ScY

# === SMS (Africa's Talking) ===
SMS_DRIVER=log
SMS_AFRICASTALKING_USERNAME=sandbox
SMS_AFRICASTALKING_API_KEY=atsk_46d4fa9d277f857310f88a3a644f845b8e7a300baa25dbdf8c22ade8da7fb28d6d827f33
